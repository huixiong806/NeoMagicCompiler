{
  "level": "2-12",
  "language": "c",
  "availableOps": [],
  "forbiddenRegs": [],
  "maxInstructions": 2000000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "四根柱子：[5, 1, 9, 3] 排成 [1, 3, 5, 9]",
        "call": { "fn": "solve", "args": [8192, 4] },
        "initial": { "0x2000": [5, 1, 9, 3] },
        "expected": { "0x2000": [1, 3, 5, 9] }
      },
      {
        "name": "已经有序：不能把它弄乱：[1, 2, 3, 4, 5]",
        "call": { "fn": "solve", "args": [8192, 5] },
        "initial": { "0x2000": [1, 2, 3, 4, 5] },
        "expected": { "0x2000": [1, 2, 3, 4, 5] }
      },
      {
        "name": "完全倒序：[5, 4, 3, 2, 1]（最费劲的一趟）",
        "call": { "fn": "solve", "args": [8192, 5] },
        "initial": { "0x2000": [5, 4, 3, 2, 1] },
        "expected": { "0x2000": [1, 2, 3, 4, 5] }
      },
      {
        "name": "全相等：[7, 7, 7]（边界）",
        "call": { "fn": "solve", "args": [8192, 3] },
        "initial": { "0x2000": [7, 7, 7] },
        "expected": { "0x2000": [7, 7, 7] }
      },
      {
        "name": "只有一个元素：[42]（边界）",
        "call": { "fn": "solve", "args": [8192, 1] },
        "initial": { "0x2000": [42] },
        "expected": { "0x2000": [42] }
      },
      {
        "name": "含负数与 0：[-3, 0, -8, 5, 1] → [-8, -3, 0, 1, 5]",
        "call": { "fn": "solve", "args": [12288, 5] },
        "initial": { "0x3000": [-3, 0, -8, 5, 1] },
        "expected": { "0x3000": [-8, -3, 0, 1, 5] }
      }
    ]
  }
}
