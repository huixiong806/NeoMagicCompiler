{
  "level": "3-4",
  "language": "asm",
  "availableOps": ["li", "lw", "sw", "sb", "addi", "add", "blt", "ble", "beq", "bne", "j", "jal", "jalr", "ecall"],
  "forbiddenRegs": [],
  "maxInstructions": 30000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "五个合法词：abc / x9 / a1b2c3 / x8 / x_y（下划线是分隔符，所以 x 和 y 各算一个），9x 不算",
        "input": { "text": "abc x9 a1b2c3 9x x_y" },
        "output": { "text": "5" },
        "expected": { "memory": { "0x2000": 5 } }
      },
      {
        "name": "词被标点切断：hello 和 world 都合法，逗号感叹号都是分隔符",
        "input": { "text": "hello, world!" },
        "output": { "text": "2" },
        "expected": { "memory": { "0x2000": 2 } }
      },
      {
        "name": "空输入：一个词也没有，输出 0",
        "input": { "text": "" },
        "output": { "text": "0" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "数字开头的词全部作废：7 不算，只有 x8 合法",
        "input": { "text": "7 x8" },
        "output": { "text": "1" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "下划线分开两边：aZ09 与 b5 都合法，中间那个孤零零的 _ 不算词",
        "input": { "text": "aZ09 _ b5" },
        "output": { "text": "2" },
        "expected": { "memory": { "0x2000": 2 } }
      },
      {
        "name": "输入以词结尾、没有分隔符：最后那个 ab 也要被数上",
        "input": { "text": "ab" },
        "output": { "text": "1" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "单个字母各成一词：A B C 是 3 个",
        "input": { "text": "A B C" },
        "output": { "text": "3" },
        "expected": { "memory": { "0x2000": 3 } }
      },
      {
        "name": "被问号包住的词也合法：a、b、c 共 3 个",
        "input": { "text": "?a?b?c?" },
        "output": { "text": "3" },
        "expected": { "memory": { "0x2000": 3 } }
      },
      {
        "name": "词中间可以夹数字：x1y2 与 z3 都合法，末尾再接一个 4w 仍是数字开头、不算（共 2 个）",
        "input": { "text": "x1y2 z3 4w" },
        "output": { "text": "2" },
        "expected": { "memory": { "0x2000": 2 } }
      },
      {
        "name": "单个词里大小写和数字混着来：a1B2c3 算 1 个",
        "input": { "text": "a1B2c3" },
        "output": { "text": "1" },
        "expected": { "memory": { "0x2000": 1 } }
      }
    ]
  }
}
