{
  "level": "4-4",
  "language": "asm",
  "availableOps": ["lb", "lbu", "sb", "lw", "sw", "li", "la", "mv", "add", "addi", "sub", "mul", "div", "rem", "beq", "bne", "blt", "bge", "j", "jal", "jalr", "ret", "ecall"],
  "forbiddenRegs": [],
  "maxInstructions": 100000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "一个数：7 → 就一个 NUM:7（边界）",
        "input": { "text": "7\n" },
        "output": { "text": "NUM:7" }
      },
      {
        "name": "单个运算符、两个数：3+5 → NUM:3 NUM:5 OP:+",
        "input": { "text": "3+5\n" },
        "output": { "text": "NUM:3\nNUM:5\nOP:+" }
      },
      {
        "name": "这就是本关的全部麻烦：乘法比加法先出来：1+2*3 → NUM:1 NUM:2 NUM:3 OP:* OP:+",
        "input": { "text": "1+2*3\n" },
        "output": { "text": "NUM:1\nNUM:2\nNUM:3\nOP:*\nOP:+" }
      },
      {
        "name": "括号抢在前面：(1+2)*3 → 后加变后乘",
        "input": { "text": "(1+2)*3\n" },
        "output": { "text": "NUM:1\nNUM:2\nOP:+\nNUM:3\nOP:*" }
      },
      {
        "name": "只有减号和除号：10-6/2 → NUM:10 NUM:6 NUM:2 OP:/ OP:-",
        "input": { "text": "10-6/2\n" },
        "output": { "text": "NUM:10\nNUM:6\nNUM:2\nOP:/\nOP:-" }
      },
      {
        "name": "同一档优先级从左往右：1-2-3 → (1-2)-3，两个减号按顺序出",
        "input": { "text": "1-2-3\n" },
        "output": { "text": "NUM:1\nNUM:2\nOP:-\nNUM:3\nOP:-" }
      },
      {
        "name": "两层括号各管各的：(1+2)*(3+4) → 两个加号都先出",
        "input": { "text": "(1+2)*(3+4)\n" },
        "output": { "text": "NUM:1\nNUM:2\nOP:+\nNUM:3\nNUM:4\nOP:+\nOP:*" }
      },
      {
        "name": "多位数不能拆错：12+345 → NUM:12 NUM:345 OP:+",
        "input": { "text": "12+345\n" },
        "output": { "text": "NUM:12\nNUM:345\nOP:+" }
      },
      {
        "name": "括号套括号：((1+2)*3)，括号只是路标，不输出",
        "input": { "text": "((1+2)*3)\n" },
        "output": { "text": "NUM:1\nNUM:2\nOP:+\nNUM:3\nOP:*" }
      },
      {
        "name": "括号里坐着乘法：(2*3)+(4*5) → 两组乘号各在加号之前",
        "input": { "text": "(2*3)+(4*5)\n" },
        "output": { "text": "NUM:2\nNUM:3\nOP:*\nNUM:4\nNUM:5\nOP:*\nOP:+" }
      },
      {
        "name": "全是空白的一行：什么都不输出（边界）",
        "input": { "text": "   \n" },
        "output": { "text": "" }
      },
      {
        "name": "深层嵌套括号要能一路钻到底：(1+(2*(3+(4*5))))",
        "input": { "text": "(1+(2*(3+(4*5))))\n" },
        "output": { "text": "NUM:1\nNUM:2\nNUM:3\nNUM:4\nNUM:5\nOP:*\nOP:+\nOP:*\nOP:+" }
      }
    ]
  }
}
