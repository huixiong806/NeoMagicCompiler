{
  "level": "1-3",
  "language": "asm",
  "availableOps": [
    "add",
    "sub",
    "addi",
    "ecall"
  ],
  "forbiddenRegs": [],
  "maxInstructions": 1000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "10 和 3：差是 7，两格互换",
        "initial": {
          "regs": {
            "x1": 10,
            "x2": 3
          },
          "sp": 3
        },
        "expected": {
          "regs": {
            "x1": 3,
            "x2": 10,
            "x3": 7
          }
        }
      },
      {
        "name": "3 和 10：差是 -7，两格互换",
        "initial": {
          "regs": {
            "x1": 3,
            "x2": 10
          },
          "sp": 10
        },
        "expected": {
          "regs": {
            "x1": 10,
            "x2": 3,
            "x3": -7
          }
        }
      },
      {
        "name": "两边都是 0：差是 0，换不换都一样",
        "initial": {
          "regs": {
            "x1": 0,
            "x2": 0
          },
          "sp": 0
        },
        "expected": {
          "regs": {
            "x1": 0,
            "x2": 0,
            "x3": 0
          }
        }
      },
      {
        "name": "-20 和 -5：差是 -15，两格互换",
        "initial": {
          "regs": {
            "x1": -20,
            "x2": -5
          },
          "sp": -5
        },
        "expected": {
          "regs": {
            "x1": -5,
            "x2": -20,
            "x3": -15
          }
        }
      }
    ]
  }
}
