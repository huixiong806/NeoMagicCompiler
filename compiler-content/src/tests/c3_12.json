{
  "level": "3-12",
  "language": "asm",
  "availableOps": [
    "li", "lui", "addi", "add", "sub", "mul", "div", "rem", "lw", "lb", "lbu", "sw", "sb",
    "beq", "bne", "blt", "bgt", "bge", "slli", "mv", "la", "j", "jal", "jalr", "ret", "ecall"
  ],
  "forbiddenRegs": [],
  "maxInstructions": 200000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "三行各一种咒文：光秃秃的表达式不算、let 不输出、print 才输出",
        "input": { "text": "1+2*3\nlet x = (1+2)*3\nprint x+1\n" },
        "output": { "text": "10\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "多行各自独立：每一行的表达式互不影响",
        "input": { "text": "1+1\n2*3\n8/2\nprint 5-9\n" },
        "output": { "text": "-4\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "空行要跳过、let 跨行仍然记得：空行 + let a = 6 + 空行 + print a*7",
        "input": { "text": "\nlet a = 6\n\n\nprint a*7\n" },
        "output": { "text": "42\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "一条 print 一行结果：两个 print 就是两行",
        "input": { "text": "let a = 2\nprint a\ndeclare\nprint a*a\n" },
        "output": { "text": "2\n4\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "没有 print 的多行程序不产生输出",
        "input": { "text": "1+2\nlet x = 9\nx*3\n" },
        "output": { "text": "" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "带负号与括号：print -(1+2)*3 输出 -9",
        "input": { "text": "print -(1+2)*3\n" },
        "output": { "text": "-9\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "一条完整的咒文序列（含变量多次改写）",
        "input": { "text": "let n = 1\nlet n = n*2+1\nprint n\nlet m = n*10\nprint m-n\nprint (n+m)/2\n" },
        "output": { "text": "3\n27\n16\n" },
        "pauseOn": { "mmio_write": false }
      },
      {
        "name": "空输入时不能崩、也不输出",
        "input": { "text": "" },
        "output": { "text": "" },
        "pauseOn": { "mmio_write": false }
      }
    ]
  }
}
