{
  "level": "3-5",
  "language": "asm",
  "availableOps": ["li", "lw", "lb", "sw", "addi", "beq", "bne", "j", "ecall"],
  "forbiddenRegs": [],
  "maxInstructions": 20000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "空输入：没有括号，也算匹配，输出 ok",
        "input": { "text": "" },
        "output": { "text": "ok" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "单个括号对：()",
        "input": { "text": "()" },
        "output": { "text": "ok" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "只有左括号：栈里留着一个没人配，输出 bad",
        "input": { "text": "(" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "只有右括号：栈是空的还要弹，输出 bad",
        "input": { "text": ")" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "三种括号嵌套两层：[({})]",
        "input": { "text": "[({})]" },
        "output": { "text": "ok" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "顺序交叉导致栈顶不匹配：([)]",
        "input": { "text": "([)]" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "括号种类对不上：左圆右方 (]",
        "input": { "text": "(]" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "左右数量对但顺序反了：)((",
        "input": { "text": ")((" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "多组并列加空格换行，全部配平：输出 ok",
        "input": { "text": "(a) [b] {c}\n()[]{}" },
        "output": { "text": "ok" },
        "expected": { "memory": { "0x2000": 1 } }
      },
      {
        "name": "前面全都配好，最后一组漏一个右括号：{})( 里的 ( 是孤儿",
        "input": { "text": "[()]{}(]{}" },
        "output": { "text": "bad" },
        "expected": { "memory": { "0x2000": 0 } }
      },
      {
        "name": "压得深也要弹得回来：五层嵌套 {([{()}])}，输出 ok",
        "input": { "text": "{([{()}])}" },
        "output": { "text": "ok" },
        "expected": { "memory": { "0x2000": 1 } }
      }
    ]
  }
}
