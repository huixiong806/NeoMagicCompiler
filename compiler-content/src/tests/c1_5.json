{
  "level": "1-5",
  "language": "asm",
  "availableOps": ["li", "lw", "sw", "ecall"],
  "forbiddenRegs": [],
  "maxInstructions": 1000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "读出 0x1000 处的 42，并把 0x2000 写进 0x2000 那一格",
        "initial": { "regs": { "x1": 8192 }, "memory": { "0x1000": 42 } },
        "expected": { "regs": { "x5": 42 }, "memory": { "0x2000": 8192 } }
      },
      {
        "name": "读出 0x1000 处的 0（空的一格）",
        "initial": { "regs": { "x1": 8192 }, "memory": { "0x1000": 0 } },
        "expected": { "regs": { "x5": 0 }, "memory": { "0x2000": 8192 } }
      },
      {
        "name": "读出 0x1000 处的 20661",
        "initial": { "regs": { "x1": 8192 }, "memory": { "0x1000": 20661 } },
        "expected": { "regs": { "x5": 20661 }, "memory": { "0x2000": 8192 } }
      }
    ]
  }
}
