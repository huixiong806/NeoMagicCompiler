{
  "level": "1-12",
  "language": "asm",
  "availableOps": ["li", "lw", "sw", "add", "addi", "blt", "j", "ebreak", "ecall"],
  "forbiddenRegs": [],
  "maxInstructions": 500,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "n = 1：一条 ebreak 之后仍要得出 x10 = 5",
        "initial": { "regs": { "x1": 1 }, "memory": { "0x1000": 5 } },
        "expected": { "regs": { "x10": 5 } }
      },
      {
        "name": "n = 3：命中三次断点，x10 = 6",
        "initial": {
          "regs": { "x1": 3 },
          "memory": { "0x1000": 1, "0x1004": 2, "0x1008": 3 }
        },
        "expected": { "regs": { "x10": 6 } }
      },
      {
        "name": "n = 5：x10 = 40",
        "initial": {
          "regs": { "x1": 5 },
          "memory": { "0x1000": 6, "0x1004": 7, "0x1008": 8, "0x100C": 9, "0x1010": 10 }
        },
        "expected": { "regs": { "x10": 40 } }
      }
    ]
  }
}
