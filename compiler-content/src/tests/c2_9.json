  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "三块符文：5×2 + 3×4 + 1×0 = 22",
        "call": { "fn": "solve", "args": [8192, 3] },
        "initial": { "0x2000": [5, 2, 3, 4, 1, 0] },
        "expected": { "ret": 22 }
      },
      {
        "name": "一块符文、份数为 0：总能量 0（边界）",
        "call": { "fn": "solve", "args": [8192, 1] },
        "initial": { "0x2000": [100, 0] },
        "expected": { "ret": 0 }
      },
      {
        "name": "空架子：n = 0 返回 0（边界）",
        "call": { "fn": "solve", "args": [8192, 0] },
        "initial": { "0x2000": [0, 0] },
        "expected": { "ret": 0 }
      },
      {
        "name": "第四块才是关键：0×9 + 2×2 + 0×0 + 3×7 = 25",
        "call": { "fn": "solve", "args": [8192, 4] },
        "initial": { "0x2000": [0, 9, 2, 2, 0, 0, 3, 7] },
        "expected": { "ret": 25 }
      },
      {
        "name": "另一个地址上的两块符文：12×12 + 1×1 = 145",
        "call": { "fn": "solve", "args": [12288, 2] },
        "initial": { "0x3000": [12, 12, 1, 1] },
        "expected": { "ret": 145 }
      }
    ]
  }
}
