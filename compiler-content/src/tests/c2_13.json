{
  "level": "2-13",
  "language": "c",
  "availableOps": [],
  "forbiddenRegs": [],
  "maxInstructions": 300000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "找 5：[1, 3, 5, 7, 9] 里在下标 2",
        "call": { "fn": "solve", "args": [8192, 5, 5] },
        "initial": { "0x2000": [1, 3, 5, 7, 9] },
        "expected": { "ret": 2 }
      },
      {
        "name": "找 1：正好是第一卷（边界）",
        "call": { "fn": "solve", "args": [8192, 5, 1] },
        "initial": { "0x2000": [1, 3, 5, 7, 9] },
        "expected": { "ret": 0 }
      },
      {
        "name": "找 9：正好是最后一卷（边界）",
        "call": { "fn": "solve", "args": [8192, 5, 9] },
        "initial": { "0x2000": [1, 3, 5, 7, 9] },
        "expected": { "ret": 4 }
      },
      {
        "name": "找 4：这卷不存在，返回 -1",
        "call": { "fn": "solve", "args": [8192, 5, 4] },
        "initial": { "0x2000": [1, 3, 5, 7, 9] },
        "expected": { "ret": -1 }
      },
      {
        "name": "找 0：比所有卷都小的编号，返回 -1",
        "call": { "fn": "solve", "args": [8192, 5, 0] },
        "initial": { "0x2000": [1, 3, 5, 7, 9] },
        "expected": { "ret": -1 }
      },
      {
        "name": "空架子：n = 0 直接返回 -1（边界）",
        "call": { "fn": "solve", "args": [8192, 0, 7] },
        "initial": { "0x2000": [0] },
        "expected": { "ret": -1 }
      }
    ]
  }
}
