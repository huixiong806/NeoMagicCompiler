{
  "level": "4-2",
  "language": "asm",
  "availableOps": [
    "li", "la", "lui", "addi", "lbu", "sb", "sw", "lw", "add", "sub", "mul",
    "div", "rem", "slli", "blt", "bgt", "bltu", "beq", "bne", "j", "jal", "jalr", "ecall"
  ],
  "forbiddenRegs": [],
  "maxInstructions": 60000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "空输入：一个 token 都没有",
        "input": { "text": "" },
        "output": { "text": "" }
      },
      {
        "name": "十进制：多位数要一位一位拼，0 单独出现就是 0",
        "input": { "text": "7 0 250 1000000\n" },
        "output": { "text": "NUM:7\nNUM:0\nNUM:250\nNUM:1000000\n" }
      },
      {
        "name": "十六进制：0x2A = 42，0xFF = 255，大小写 x 都认，数值一律用十进制印",
        "input": { "text": "0x2A 0xff 0X10\n" },
        "output": { "text": "NUM:42\nNUM:255\nNUM:16\n" }
      },
      {
        "name": "字符字面量：输出的不是字符而是它的码值",
        "input": { "text": "'A' 'z' '0'\n" },
        "output": { "text": "CHR:65\nCHR:122\nCHR:48\n" }
      },
      {
        "name": "字符字面量里的转义：'\\n' 是 10，'\\'' 是 39",
        "input": { "text": "'\\n' '\\''\n" },
        "output": { "text": "CHR:10\nCHR:39\n" }
      },
      {
        "name": "字符串字面量：内容原样输出，不含两侧引号",
        "input": { "text": "\"hello\" \"a b\"\n" },
        "output": { "text": "STR:hello\nSTR:a b\n" }
      },
      {
        "name": "字符串里的转义：\\n 换成真正的换行；两侧空白会被判定丢掉，所以转义 \\t 不算合格测例",
        "input": { "text": "\"a\\nb\"\n" },
        "output": { "text": "STR:a\nb\n" }
      },
      {
        "name": "混在一起的一小段源码：关键字、名字、十进制、十六进制、字符、字符串、符号各就各位",
        "input": { "text": "int main() {\n  int a = 0x10;\n  char c = 'A';\n  return \"ok\";\n}\n" },
        "output": {
          "text": "KW:int\nID:main\nOP:(\nOP:)\nOP:{\nKW:int\nID:a\nOP:=\nNUM:16\nOP:;\nID:char\nID:c\nOP:=\nCHR:65\nOP:;\nKW:return\nSTR:ok\nOP:;\nOP:}\n"
        }
      },
      {
        "name": "数字和名字不要粘错：0x10 是一个数，x10 却是一个名字",
        "input": { "text": "0x10 x10 10\n" },
        "output": { "text": "NUM:16\nID:x10\nNUM:10\n" }
      }
    ]
  }
}
