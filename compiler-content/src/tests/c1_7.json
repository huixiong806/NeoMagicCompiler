{
  "level": "1-7",
  "language": "asm",
  "availableOps": [
    "addi",
    "beq",
    "bne",
    "j",
    "ecall"
  ],
  "forbiddenRegs": [],
  "maxInstructions": 1000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "7 和 7：相等，x3 = 1",
        "initial": {
          "regs": {
            "x1": 7,
            "x2": 7
          },
          "sp": 7
        },
        "expected": {
          "regs": {
            "x3": 1
          }
        }
      },
      {
        "name": "7 和 8：不相等，x3 = 0",
        "initial": {
          "regs": {
            "x1": 7,
            "x2": 8
          },
          "sp": 8
        },
        "expected": {
          "regs": {
            "x3": 0
          }
        }
      },
      {
        "name": "两个都是 0：也是相等，x3 = 1",
        "initial": {
          "regs": {
            "x1": 0,
            "x2": 0
          },
          "sp": 0
        },
        "expected": {
          "regs": {
            "x3": 1
          }
        }
      },
      {
        "name": "-1 和 -1：负数相等，x3 = 1",
        "initial": {
          "regs": {
            "x1": -1,
            "x2": -1
          },
          "sp": -1
        },
        "expected": {
          "regs": {
            "x3": 1
          }
        }
      }
    ]
  }
}
