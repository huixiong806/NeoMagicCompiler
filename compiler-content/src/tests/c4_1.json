{
  "level": "4-1",
  "language": "asm",
  "availableOps": [
    "li", "la", "lui", "addi", "lbu", "sb", "sw", "lw", "add", "sub", "mul", "div", "rem", "slli",
    "blt", "bgt", "bltu", "beq", "bne", "j", "jal", "jalr", "ecall"
  ],
  "forbiddenRegs": [],
  "maxInstructions": 60000,
  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "空输入：源码是空的，一个 token 都不该有",
        "input": { "text": "" },
        "output": { "text": "" }
      },
      {
        "name": "只有一个标识符（周围全是空白，空白不产生 token）",
        "input": { "text": "  \n\t x  \n" },
        "output": { "text": "ID:x\n" }
      },
      {
        "name": "先认关键字再认名字：int 与 void 是 KW，main 是 ID",
        "input": { "text": "int main void\n" },
        "output": { "text": "KW:int\nID:main\nKW:void\n" }
      },
      {
        "name": "多位数要一位一位拼起来，不能输出 4 和 2 两个 token",
        "input": { "text": "42 7 1000\n" },
        "output": { "text": "NUM:42\nNUM:7\nNUM:1000\n" }
      },
      {
        "name": "二字符运算符：<= 和 == 各自是一个 token；< = 分开写是两个",
        "input": { "text": "a <= b == c < = d\n" },
        "output": { "text": "ID:a\nOP:<=\nID:b\nOP:==\nID:c\nOP:<\nOP:=\nID:d\n" }
      },
      {
        "name": "逻辑运算符 && 与 || 也要看成两个字符",
        "input": { "text": "x && y || z\n" },
        "output": { "text": "ID:x\nOP:&&\nID:y\nOP:||\nID:z\n" }
      },
      {
        "name": "一小段完整源码：换行与缩进只是空白，括号分号逗号各自一个 token",
        "input": { "text": "int add(int a, int b) {\n\treturn a + b;\n}\n" },
        "output": {
          "text": "KW:int\nID:add\nOP:(\nKW:int\nID:a\nOP:,\nKW:int\nID:b\nOP:)\nOP:{\nKW:return\nID:a\nOP:+\nID:b\nOP:;\nOP:}\n"
        }
      },
      {
        "name": "遇到不认识的字符：输出 ERR:那个字符，然后收工",
        "input": { "text": "x # y\n" },
        "output": { "text": "ID:x\nERR:#\n" }
      },
      {
        "name": "单字符运算符后面还有标识符：符号看完的那一眼要还回去，后面的词不能丢",
        "input": { "text": "a < b" },
        "output": { "text": "ID:a\nOP:<\nID:b\n" }
      },
      {
        "name": "while / else / return 也都是关键字（VALUE 保留原文）",
        "input": { "text": "while else return\n" },
        "output": { "text": "KW:while\nKW:else\nKW:return\n" }
      }
    ]
  }
}
